/**
 * JonesBros.gs — one-click import of the Jones Bros Contractors new-hire safety
 * orientation into Kleared. Generated from JBC_Orientacion_Seguridad_2026.pptx
 * (65 slides, EN + ES). Add this file to the SAME Apps Script project as Code.gs,
 * then run importJonesBros() once. It:
 *   - creates (or updates) a Sites row for Jones Bros with all 60 modules,
 *   - flags it as a FULL PROGRAM (workers see this instead of the 5 generic
 *     core modules),
 *   - loads their own 5-question quiz (replaces the default quiz), and
 *   - adds a portal login code so Jones Bros can manage their own jobsites.
 * The modules are gzip-compressed into the cell automatically (encodeModules_),
 * so the whole program fits in one Google Sheet cell. Re-running is safe - it
 * upserts by SITE code, it does not duplicate.
 *
 * Tweak the 4 constants below BEFORE running if you already set Jones Bros up in
 * the portal (set JBC_CODE to that jobsite's existing code to update it in place).
 */

const JBC_GC = "Jones Bros Contractors";
const JBC_CODE = "JBC";                                   // Sites tab column A (site code)
const JBC_SITE = "Jones Bros — New-Hire Safety Orientation";
const JBC_ADMIN_CODE = "JONESBROS";                        // portal login code for Jones Bros
const JBC_NOTES_EN = "Welcome to Jones Bros. Work through the full orientation below, then sign and take the short quiz. Questions: HR@jonesbroscont.com · 615-773-3160.";
const JBC_NOTES_ES = "Bienvenido a Jones Bros. Complete la orientación completa abajo, luego firme y tome el examen corto. Preguntas: HR@jonesbroscont.com · 615-773-3160.";

function importJonesBros() {
  const sheets = getSheets_();
  const sites = sheets.sites;
  const admins = sheets.admins;

  // 1) Portal login for Jones Bros (upsert by code).
  var aRows = admins.getDataRange().getValues();
  var aFound = false;
  for (var i = 1; i < aRows.length; i++) {
    if (String(aRows[i][0]).trim().toUpperCase() === JBC_ADMIN_CODE.toUpperCase()) {
      admins.getRange(i + 1, 1, 1, 3).setValues([[JBC_ADMIN_CODE, JBC_GC, "YES"]]);
      aFound = true; break;
    }
  }
  if (!aFound) admins.appendRow([JBC_ADMIN_CODE, JBC_GC, "YES"]);

  // 2) Sites row: full program + quiz (upsert by site code), compressed + flagged.
  return withLock_(function () {
    var modules = serverCleanModules_(JBC_PROGRAM);
    var quiz = serverCleanQuiz_(JBC_QUIZ);
    var rows = sites.getDataRange().getValues();
    var rowIdx = -1;
    for (var j = 1; j < rows.length; j++) {
      if (String(rows[j][0]).trim().toUpperCase() === JBC_CODE.toUpperCase()) { rowIdx = j + 1; break; }
    }
    var values = [JBC_CODE, JBC_GC, JBC_SITE, "YES", JBC_NOTES_EN, JBC_NOTES_ES,
      encodeModules_(modules), "YES", encodeCell_(JSON.stringify(quiz))];
    if (rowIdx > 0) sites.getRange(rowIdx, 1, 1, QUIZ_COL).setValues([values]);
    else sites.appendRow(values);
    SpreadsheetApp.flush();
    Logger.log("Jones Bros imported: " + modules.length + " modules + " + quiz.length +
      "-question quiz, full-program ON, login code " + JBC_ADMIN_CODE +
      ". Now redeploy (Manage deployments -> New version).");
    return { ok: true, modules: modules.length, quiz: quiz.length };
  });
}

// 60 orientation modules (bilingual). Data only - do not edit by hand.
const JBC_PROGRAM = [
  {"titleEn":"Welcome — what we cover today","titleEs":"Bienvenido — lo que cubrimos hoy","pointsEn":["Block 1 — How the company works: HR, drug policy, benefits, probation period.","Block 2 — Jones Bros safety rules: reporting, Focus 4, PPE, equipment, HazCom.","Block 3 — Recognizing hazards: the 4 deadly hazards, heavy equipment, trenches, falls, confined spaces, fire.","At the end: attendance signature and a short exam.","Goal: that you go home every day the same way you arrived."],"pointsEs":["Bloque 1 — Cómo funciona la compañía: Recursos Humanos, política de drogas, beneficios, período de prueba.","Bloque 2 — Las reglas de seguridad de Jones Bros: reportes, Focus 4, EPP, equipo, HazCom.","Bloque 3 — Reconocer los peligros: los 4 peligros mortales, equipo pesado, zanjas, caídas, espacios confinados, fuego.","Al terminar: firma de asistencia y examen corto.","Objetivo: que usted regrese a su casa cada día igual que como llegó."]},
  {"titleEn":"Company · Office contacts","titleEs":"Compañía · Contactos de la oficina","pointsEn":["Human Resources (HR): HR@jonesbroscont.com · 615-773-3160 — benefits, pay, vacation, complaints. Call ahead for an appointment.","Compliance: Compliance@jonesbroscont.com · 615-864-7388 — TDOT audits, OJT training.","EEO Officer: Alexandria Burd."],"pointsEs":["Recursos Humanos (HR): HR@jonesbroscont.com · 615-773-3160 — preguntas de beneficios, pago, vacaciones, quejas. Llame antes para hacer una cita.","Cumplimiento (Compliance): Compliance@jonesbroscont.com · 615-864-7388 — auditorías de TDOT, entrenamiento OJT.","Oficial de EEO: Alexandria Burd."]},
  {"titleEn":"Company · Equal opportunity (EEO)","titleEs":"Compañía · Igualdad de oportunidades (EEO)","pointsEn":["Jones Bros is a federal contractor — we follow TDOT and FHWA rules.","No discrimination by race, color, sex, gender, age, national origin, veteran status, religion or disability.","No harassment, coercion or discrimination on any jobsite. Everyone gets the same treatment — no favoritism.","TDOT reviews projects every year and may interview employees on site. Don't feel intimidated — they'll ask who the EEO officer is and whether you got this training.","Interested in on-the-job training (OJT)? Tell your supervisor.","The EEO officer is Alexandria Burd. Today you are receiving your EEO training."],"pointsEs":["Jones Bros es contratista federal — seguimos las reglas de TDOT y FHWA.","No discriminamos por raza, color, sexo, género, edad, origen nacional, condición de veterano, religión ni discapacidad.","Sin acoso, coerción ni discriminación en ningún sitio de trabajo. Todos reciben el mismo trato — no hay favoritismos.","TDOT revisa proyectos cada año y puede entrevistar empleados en el sitio. No se sienta intimidado — le preguntarán quién es la oficial de EEO y si recibió este entrenamiento.","¿Interesado en ser aprendiz en el trabajo (OJT)? Dígale a su supervisor.","La oficial de EEO es Alexandria Burd. Hoy usted está recibiendo su entrenamiento de EEO."]},
  {"titleEn":"Company · How to file a complaint","titleEs":"Compañía · Cómo presentar una queja","pointsEn":["The formal process is in the employee handbook.","If you feel there is discrimination: contact Human Resources.","Site issues (wrong hours on a stub, schedule, etc.) can be solved with your supervisor.","HR talks with you in confidence and keeps you informed while it's resolved.","Some situations require others to get involved to find a solution.","No retaliation against anyone for reporting a situation."],"pointsEs":["El proceso formal está en el manual del empleado.","Si siente que hay discriminación: contacte a Recursos Humanos.","Cosas del sitio (horas mal en el talón, horario, etc.) se pueden resolver con su supervisor.","HR habla con usted en confianza y lo mantiene informado mientras se resuelve.","Algunas situaciones requieren que otras personas se involucren para encontrar solución.","No se permiten represalias contra nadie por reportar una situación."]},
  {"titleEn":"Company · Drug- and alcohol-free workplace","titleEs":"Compañía · Lugar de trabajo libre de drogas y alcohol","pointsEn":["No possessing, using, selling or being under the influence of alcohol or illegal drugs on company property or business.","Pre-employment test — you already took it before starting.","Post-accident — any injury or damage to equipment/property = a test, no exception.","Random — chosen by an outside administrator each quarter. No one from Jones Bros takes part. You may never come up, or come up several times.","Reasonable suspicion — if a supervisor or coworker sees signs, they call Kathleen and, if warranted, a test is done."],"pointsEs":["Prohibido poseer, usar, vender o estar bajo la influencia de alcohol o drogas ilegales en propiedad o negocio de la compañía.","Prueba de pre-empleo — ya la tomó antes de entrar.","Post-accidente — cualquier lesión o daño a equipo/propiedad = prueba, sin excepción.","Aleatoria — la escoge un administrador externo cada trimestre. Nadie de Jones Bros participa. Puede que nunca salga, o que salga varias veces.","Sospecha razonable — si un supervisor o compañero ve señales, llama a Kathleen y, si se justifica, se hace la prueba."]},
  {"titleEn":"Company · Drug-testing rules","titleEs":"Compañía · Reglas de las pruebas de drogas","pointsEn":["Refuse the test: termination.","\"Non-negative\" result: you go home until the lab confirms. If confirmed positive: termination.","Negative result: back to work and paid one day. If the lab takes more than 24 hours, the rest is unpaid.","Prescription meds: recommended (not required) to send the list to hr@jonesbroscont.com. It must come from the prescribing doctor and say whether it affects operating machinery. Kept in a separate confidential file (HIPAA).","Keep your medications in the original container and tell your supervisor."],"pointsEs":["Si rehúsa la prueba: despido.","Resultado \"no negativo\": se va a casa hasta que el laboratorio confirme. Si se confirma positivo: despido.","Resultado negativo: regresa al trabajo y se le paga un día. Si el laboratorio tarda más de 24 horas, el resto es sin pago.","Medicamentos recetados: se recomienda (no es obligatorio) enviar la lista a hr@jonesbroscont.com. Debe venir del médico que recetó y decir si afecta la operación de maquinaria. Se guarda en un archivo confidencial separado (HIPAA).","Guarde sus medicamentos en el envase original y avise a su supervisor."]},
  {"titleEn":"Company · Cell phones","titleEs":"Compañía · Teléfonos celulares","pointsEn":["Leave it in your vehicle and check it only on breaks.","Give your supervisor's or HR's number to anyone who needs to reach you in an emergency.","No cell phone should be seen in use while you work or operate machinery.","No phone use while operating equipment.","No phone or earbuds while directing traffic.","Phone use at work can result in disciplinary action."],"pointsEs":["Déjelo en su vehículo y revíselo solo en los descansos.","Dele el número de su supervisor o de HR a quien necesite localizarlo en una emergencia.","No se debe ver un celular en uso mientras trabaja u opera maquinaria.","Prohibido usar el celular operando equipo.","Prohibido usar celular o audífonos cuando está dirigiendo tráfico.","El uso del celular en el trabajo puede resultar en acción disciplinaria."]},
  {"titleEn":"Company · 90-day probation period","titleEs":"Compañía · Período de prueba: 90 días","pointsEn":["Tennessee is an \"at will\" employment state.","Every new employee goes through 90 days of evaluation with their supervisor. It does not guarantee 90 days of work nor require you to stay 90 days.","During these 90 days you wear the GREEN hi-vis hard hat — whether you're new to the industry or a veteran — so everyone knows who's new to Jones Bros.","New employees account for about 80% of companies' incidents.","At 90 days: a 1:1 meeting with your supervisor — safety, attendance, attitude. And you get your Jones Bros cap."],"pointsEs":["Tennessee es un estado de empleo \"a voluntad\" (at will).","Todo empleado nuevo pasa por 90 días de evaluación con su supervisor. No garantiza 90 días de trabajo ni lo obliga a quedarse 90 días.","Durante estos 90 días usa el casco VERDE de alta visibilidad — no importa si es nuevo en la industria o veterano — así todos saben quién es nuevo en Jones Bros.","Los empleados nuevos representan cerca del 80% de los incidentes de las compañías.","A los 90 días: reunión 1:1 con su supervisor — seguridad, asistencia, actitud. Y recibe su gorra de Jones Bros."]},
  {"titleEn":"Company · Disciplinary policy","titleEs":"Compañía · Política disciplinaria","pointsEn":["First time: verbal warning.","Second time: written warning.","Third time: written warning + days without pay.","Last: termination.","Serious offenses can result in immediate termination. Examples of warnings: showing up late, no-call/no-show, damage to equipment, etc."],"pointsEs":["Primera vez: advertencia verbal.","Segunda vez: advertencia por escrito.","Tercera vez: advertencia por escrito + días sin pago.","Última: despido.","Faltas graves pueden resultar en despido inmediato. Ejemplos de advertencias: llegar tarde, no llamar/no presentarse, daño a equipo, etc."]},
  {"titleEn":"Company · Benefits","titleEs":"Compañía · Beneficios","pointsEn":["Eligible the 1st of the month after you complete 60 days of employment.","We offer: health, dental, vision, long-term disability (LTD), life insurance, HSA and 401K.","You'll get the enrollment package by email within a week after this orientation.","The premium is deducted one month ahead — depending on when you finish your paperwork, you may see double deductions until you catch up.","HSA: a tax-savings option to help with the deductible.","First Horizon: a free, confidential financial-planning session. You don't need an account with them. Ask HR.","We want you to understand the value of your benefits, not just the price. Call HR with any questions."],"pointsEs":["Es elegible el día 1 del mes después de cumplir 60 días de empleo.","Ofrecemos: salud, dental, visión, incapacidad a largo plazo (LTD), seguro de vida, HSA y 401K.","Recibirá el paquete de inscripción por correo electrónico dentro de una semana después de esta orientación.","La prima se descuenta un mes por adelantado — según cuándo complete su papeleo, puede ver descuentos dobles hasta ponerse al día.","HSA: opción de ahorro de impuestos para ayudar con el deducible.","First Horizon: sesión gratuita y confidencial de planificación financiera. No necesita tener cuenta con ellos. Pregunte en HR.","Queremos que entienda el valor de sus beneficios, no solo el precio. Llame a HR con cualquier duda."]},
  {"titleEn":"Company · 401K","titleEs":"Compañía · 401K","pointsEn":["Eligible the quarter after you complete 6 months of work.","Enrollment is AUTOMATIC — if you don't want to participate, you have to opt out.","The package comes to your home by mail from TransAmerica (outside administrator).","The company makes a matching contribution — details in your package.","Keep your address current with HR so all mail arrives correctly."],"pointsEs":["Elegible el trimestre después de cumplir 6 meses de trabajo.","La inscripción es AUTOMÁTICA — si no quiere participar, tiene que darse de baja.","El paquete llega a su casa por correo desde TransAmerica (administrador externo).","La compañía hace una contribución de contrapartida (match) — detalles en su paquete.","Mantenga su dirección actualizada con HR para que todo el correo llegue bien."]},
  {"titleEn":"Company · Pay and check stubs","titleEs":"Compañía · Pago y talones de cheque","pointsEn":["Stubs are emailed each week by Karen Ethridge — also check your spam folder.","Contacts: Kethridge@jonesbroscont.com or sbruce@jonesbroscont.com.","Stub password: your employee number followed by the last 4 of your Social Security number. Ask your supervisor for your employee number.","Stubs normally go out Wednesdays. Call the office only if you haven't received it by Friday.","No matter what day the stub goes out — the money lands in your account on Friday."],"pointsEs":["Los talones se envían por correo electrónico cada semana por Karen Ethridge — revise también la carpeta de spam.","Contactos: Kethridge@jonesbroscont.com o sbruce@jonesbroscont.com.","Contraseña del talón: su número de empleado seguido de los últimos 4 de su seguro social. Pida su número de empleado a su supervisor.","Normalmente salen los miércoles. Llame a la oficina solo si no lo recibió para el viernes.","No importa qué día salga el talón — el dinero cae en su cuenta el viernes."]},
  {"titleEn":"Company · Vacation / PTO","titleEs":"Compañía · Vacaciones / PTO","pointsEn":["Year 1: accrues 1.08 hours per week — 56 hours a year.","After year 1: 1.54 hours per week — 80 hours a year.","After 10 years: 2.31 hours per week — 120 hours a year.","You start accruing from your first week. You can bank up to 160 hours — they are not lost."],"pointsEs":["Año 1: acumula 1.08 horas por semana — 56 horas al año.","Después del año 1: 1.54 horas por semana — 80 horas al año.","Después de 10 años: 2.31 horas por semana — 120 horas al año.","Empieza a acumular desde la primera semana. Puede guardar hasta 160 horas — no se pierden."]},
  {"titleEn":"Company · How to use your PTO","titleEs":"Compañía · Cómo usar su PTO","pointsEn":["It's your time — tell your supervisor about days off as soon as possible.","It also covers sick or rain days — let them know so it's added to payroll.","You must use your vacation before taking unpaid leave.","There is no bereavement policy — PTO hours are used for a death.","To check your hours: call HR or write to whoever sends your stub."],"pointsEs":["Es su tiempo — avise a su supervisor lo más pronto posible sobre días libres.","También sirve para días de enfermedad o de lluvia — avise para que lo metan en la nómina.","Debe usar sus vacaciones antes de tomar permiso sin pago.","No hay política de duelo — para un fallecimiento se usan horas de PTO.","Para saber cuántas horas tiene: llame a HR o escriba a quien le envía el talón."]},
  {"titleEn":"Company · Birthdays and births","titleEs":"Compañía · Cumpleaños y nacimientos","pointsEn":["Your birthday: one paid day off. Must be used within 7 days of your birthday.","You have to take the day — you can't work and collect the hours. It counts toward 40 hours, not overtime.","Birth of a child or grandchild: tell HR. We want to celebrate with you.","You get a Jones Bros gift package for the newborn."],"pointsEs":["Su cumpleaños: un día pagado libre. Debe usarse dentro de los 7 días de su cumpleaños.","Tiene que tomar el día — no puede trabajar y cobrar las horas. Cuenta hacia las 40 horas, no hacia tiempo extra.","Nacimiento de hijo o nieto: avise a HR. Queremos celebrar con usted.","Recibe un paquete de regalo de Jones Bros para el recién nacido."]},
  {"titleEn":"Safety Rules · Jones Bros safety commitment","titleEs":"Reglas de Seguridad · Compromiso con la seguridad","pointsEn":["Safety is our #1 priority. Goal: ZERO accidents and injuries on our projects.","We prevent injuries and also damage to equipment, vehicles, company and third-party property.","No job or task is more important than you or the people on your project.","Each worker is responsible for their own safety and their coworkers'.","Every employee has the authority to STOP WORK.","We want to send you home every day the same way you came in."],"pointsEs":["La seguridad es nuestra prioridad #1. Meta: CERO accidentes y lesiones en nuestros proyectos.","Prevenimos lesiones y también daños a equipo, vehículos, propiedad de la compañía y de terceros.","Ningún trabajo ni tarea es más importante que usted o que la gente en su proyecto.","Cada trabajador es responsable de su propia seguridad y de la de sus compañeros.","Todo empleado tiene autoridad para PARAR EL TRABAJO.","Queremos mandarlo a su casa cada día igual que como llegó."]},
  {"titleEn":"Safety Rules · Stop Work authority","titleEs":"Reglas de Seguridad · Autoridad para PARAR el trabajo","pointsEn":["Every employee and subcontractor is REQUIRED to stop work when they see an unsafe condition or environmental risk.","No one has to do a job that puts you or others in danger.","Stop all work in the affected area, contact the supervisor or safety team, and don't continue until everything is safe.","The 3-step process: EVALUATE the risk — what can go wrong? what's the worst that can happen?","ANALYZE how to reduce it — do I have the training, tools and PPE?","ACT — follow the procedures, ask for help if you need it.","For everyone. Every day. All the time."],"pointsEs":["Todo empleado y subcontratista está OBLIGADO a parar el trabajo cuando vea una condición insegura o un riesgo ambiental.","Nadie tiene que hacer un trabajo que lo ponga en peligro a usted o a otros.","Se para todo el trabajo en el área afectada, se contacta al supervisor o al equipo de seguridad, y no se continúa hasta que todo esté seguro.","El proceso de 3 pasos: EVALUAR el riesgo — ¿qué puede salir mal? ¿qué es lo peor que puede pasar?","ANALIZAR cómo reducirlo — ¿tengo el entrenamiento, las herramientas y el EPP?","ACTUAR — siga los procedimientos, pida ayuda si la necesita.","Para todos. Todos los días. Todo el tiempo."]},
  {"titleEn":"Safety Rules · Safety meetings and training","titleEs":"Reglas de Seguridad · Reuniones y entrenamientos","pointsEn":["Every morning: JSA + crew meeting (5-10 min). Each employee signs on the supervisor's tablet.","Every week: toolbox talk — each employee signs that they did it.","Every month: safety bulletin — company news and the previous month's incidents.","Every year: all-employee annual meeting — EEO, safety, updates.","Throughout the year: CPR/First Aid, OSHA 10/30, Trench Competent Person, confined space, flagging, etc.","Interested in a training? Tell your supervisor. If it benefits the work, he coordinates it with safety."],"pointsEs":["Cada mañana: JSA + reunión de cuadrilla (5-10 min). Cada empleado firma en la tableta del supervisor.","Cada semana: charla de caja de herramientas (toolbox talk) — cada empleado firma que la hizo.","Cada mes: boletín de seguridad — novedades de la compañía e incidentes del mes anterior.","Cada año: reunión anual de todos los empleados — EEO, seguridad, actualizaciones.","Durante el año: CPR/Primeros Auxilios, OSHA 10/30, Persona Competente en zanjas, espacio confinado, abanderamiento, etc.","¿Le interesa un entrenamiento? Dígale a su supervisor. Si beneficia al trabajo, él lo coordina con seguridad."]},
  {"titleEn":"Safety Rules · The JSA (Job Safety Analysis)","titleEs":"Reglas de Seguridad · El JSA (Análisis de Seguridad del Trabajo)","pointsEn":["What a JSA contains: the day's tasks broken into steps, the hazards of each task, and how each hazard is controlled.","Project name and exact location — used in an emergency. Nearest hospital and how to get there. Emergency contacts and muster point.","Done daily, before the shift starts. Again when the task, weather, or a new hazard changes.","For critical or non-routine tasks: critical lifts, confined space, winch use.","The whole crew: foreman, operators, laborers.","Every site visitor gets the JSA and the red zones before entering."],"pointsEs":["Qué lleva un JSA: las tareas del día divididas en pasos, los peligros de cada tarea, y cómo se controla cada peligro.","Nombre del proyecto y ubicación exacta — se usa en una emergencia. Hospital más cercano y cómo llegar. Contactos de emergencia y punto de reunión.","Se hace diario, antes de empezar el turno. Otra vez cuando cambia la tarea, el clima o aparece un peligro nuevo.","Para tareas críticas o no rutinarias: izajes críticos, espacio confinado, uso de malacate.","Toda la cuadrilla: capataz, operadores, laboristas.","Todo visitante al sitio recibe el JSA y las zonas rojas antes de entrar."]},
  {"titleEn":"Safety Rules · Accident notification — who to call","titleEs":"Reglas de Seguridad · Notificación de accidentes — a quién llamar","pointsEn":["1) Roman Kelly (Safety) — 270-227-3886.","2) Colin Rice (Safety) — 615-585-6930.","3) Andrew Wall (President) — Office 615-864-7388 · Cell 615-519-0469.","Report immediately: personal injuries, vehicle accidents, equipment damage, damage to public or third-party property, and any emergency.","The written report is turned in within 24 hours."],"pointsEs":["1) Roman Kelly (Seguridad) — 270-227-3886.","2) Colin Rice (Seguridad) — 615-585-6930.","3) Andrew Wall (Presidente) — Oficina 615-864-7388 · Cel 615-519-0469.","Se reporta de inmediato: lesiones personales, accidentes vehiculares, daño a equipo, daño a propiedad pública o de terceros, y cualquier emergencia.","El reporte escrito se entrega dentro de 24 horas."]},
  {"titleEn":"Safety Rules · Report EVERYTHING — big or small","titleEs":"Reglas de Seguridad · Reporte TODO — grande o pequeño","pointsEn":["Any incident at work is reported to your supervisor, no matter how small.","Example: a pulled muscle or small cut that \"doesn't bother you.\" You get home, it worsens or gets infected and needs a doctor. If you didn't report it that day, there's no way to prove it happened at work.","Reporting does NOT mean you have to go home, see a doctor, or lose work time. We just need the documentation in case the injury worsens.","Near misses and property damage are also reported.","Not reporting an incident can result in disciplinary action."],"pointsEs":["Cualquier incidente en el trabajo se reporta a su supervisor, sin importar qué tan pequeño.","Ejemplo: un músculo estirado o una cortada chica que \"no molesta\". Llega a casa, empeora o se infecta y necesita al médico. Si no lo reportó ese día, no hay forma de comprobar que pasó en el trabajo.","Reportar NO significa que tiene que irse a casa, ir al médico ni perder tiempo de trabajo. Solo necesitamos la documentación por si la lesión empeora.","También se reportan los casi-accidentes (near miss) y daños a la propiedad.","No reportar un incidente puede resultar en acción disciplinaria."]},
  {"titleEn":"Safety Rules · If an incident occurs","titleEs":"Reglas de Seguridad · Si ocurre un incidente","pointsEn":["Respond: assess the scene — is anyone still in immediate danger? Attend to the injured.","Call emergency services if needed — don't hesitate.","Notify the chain of command: foreman → superintendent → safety.","If needed, send someone in a vehicle to the project entrance to guide the ambulance.","Secure the scene: make sure you and the victim are not in more danger. Preserve the scene — don't move or clean anything. Don't let unnecessary people gather around.","The foreman fills out the report: photos, what happened, time, place, who was involved (name and phone), injuries or damage."],"pointsEs":["Responder: evalúe la escena — ¿alguien sigue en peligro inmediato? Atienda al lesionado.","Llame a emergencias si es necesario — no lo dude.","Notifique la cadena de mando: capataz → superintendente → seguridad.","Si hace falta, mande a alguien en un vehículo a la entrada del proyecto para guiar a la ambulancia.","Asegurar la escena: asegúrese de que usted y la víctima no estén en más peligro. Preserve la escena — no mueva ni limpie nada. No deje que gente innecesaria se junte alrededor.","El capataz llena el reporte: fotos, qué pasó, hora, lugar, quién estuvo involucrado (nombre y teléfono), lesiones o daños."]},
  {"titleEn":"Safety Rules · Incident investigation","titleEs":"Reglas de Seguridad · Investigación de incidentes","pointsEn":["We investigate them all: near misses, first aid, recordables, and property damage.","The goal is to keep it from happening again — we look for FACTS, not who to BLAME.","Method: ask \"why?\" until you reach the root cause.","The root cause is almost always in planning, design or operation — not in one person.","If you take part in an investigation: be precise and complete, say only what you saw. No \"I think...\" or \"he probably...\"","Corrective actions come out of the investigation."],"pointsEs":["Se investigan todos: casi-accidentes, primeros auxilios, registrables y daños a la propiedad.","El objetivo es evitar que vuelva a pasar — buscamos HECHOS, no CULPABLES.","Método: preguntar \"¿por qué?\" hasta llegar a la causa raíz.","La causa raíz casi siempre está en la planificación, el diseño o la operación — no en una sola persona.","Si participa en una investigación: sea preciso y completo, diga solo lo que vio. Sin \"yo creo que...\" ni \"él probablemente...\"","De la investigación salen acciones correctivas."]},
  {"titleEn":"Safety Rules · Doctor panel and return to work","titleEs":"Reglas de Seguridad · Panel de médicos y regreso al trabajo","pointsEn":["If you're injured and need medical care, we offer a panel of 3 doctors — you choose.","Muscle injury (strain, pull) and you don't want to see a doctor: there's an option with a physical-therapy company that evaluates you and gives you exercises to do at home.","If the doctor puts you on light duty, Jones Bros offers it 100%: cleanup, sweeping, or operating equipment depending on the injury.","If you're offered light duty and don't show up: you're not paid."],"pointsEs":["Si se lesiona y necesita atención médica, le ofrecemos un panel de 3 médicos — usted escoge.","Lesión muscular (torcedura, estirón) y no quiere ver al médico: hay opción con una compañía de terapia física que lo evalúa y le da ejercicios para hacer en casa.","Si el médico lo manda a trabajo liviano, Jones Bros lo ofrece al 100%: limpieza, barrer u operar equipo según la lesión.","Si le ofrecen trabajo liviano y no se presenta: no se le paga."]},
  {"titleEn":"Safety Rules · First aid","titleEs":"Reglas de Seguridad · Primeros auxilios","pointsEn":["Every project and every company vehicle has a first-aid kit. They're inspected monthly; what's used is restocked.","Know where the kit is and what's in it.","Some plants and projects have an AED (defibrillator).","Each crew must have at least 2 people trained in first aid and CPR.","Only trained people give first aid / CPR."],"pointsEs":["Cada proyecto y cada vehículo de la compañía tiene botiquín de primeros auxilios. Se inspeccionan cada mes; lo que se usa se repone.","Sepa dónde está el botiquín y qué tiene.","Algunas plantas y proyectos tienen DEA (desfibrilador).","Cada cuadrilla debe tener al menos 2 personas entrenadas en primeros auxilios y CPR.","Solo los entrenados dan primeros auxilios / CPR."]},
  {"titleEn":"Safety Rules · Working for general contractors (GCs)","titleEs":"Reglas de Seguridad · Trabajando para contratistas generales (GC)","pointsEn":["We do a lot of work for general contractors. Each GC is different and has its own safety expectations.","We NEVER deviate from our safety plan.","If the GC has stricter rules than ours, we follow the GC's.","If a GC puts you in a situation that feels unsafe: call your supervisor so he comes to evaluate."],"pointsEs":["Hacemos mucho trabajo para contratistas generales. Cada GC es diferente y tiene sus propias expectativas de seguridad.","NUNCA nos apartamos de nuestro plan de seguridad.","Si el GC tiene reglas más estrictas que las nuestras, seguimos las del GC.","Si un GC lo pone en una situación que se siente insegura: llame a su supervisor para que venga a evaluar."]},
  {"titleEn":"Focus 4 · The green card","titleEs":"Focus 4 · La tarjeta verde","pointsEn":["On arrival you get a green pocket card: Jones Bros Focus 4. You must carry it on site at all times.","It covers OSHA's 4 deadly hazards: Falls, Caught, Struck-by and Electrical — with NON-NEGOTIABLES in each.","Violation: you go home WITHOUT PAY for the rest of the day. If it's in the second half of the shift, the next day too.","On return: an all-site meeting to discuss the non-negotiable and what will be done.","Then: a meeting with the superintendent, safety and/or management."],"pointsEs":["Al entrar recibe una tarjeta verde de bolsillo: Jones Bros Focus 4. Debe llevarla en el sitio siempre.","Cubre los 4 peligros mortales de OSHA: Caídas, Atrapado, Golpeado y Eléctrico — con NO NEGOCIABLES en cada uno.","Violación: se va a casa SIN PAGO por el resto del día. Si es en la segunda mitad del turno, también el día siguiente.","Al regresar: reunión de todo el sitio para hablar del no negociable y qué se va a hacer.","Luego: reunión con el superintendente, seguridad y/o la gerencia."]},
  {"titleEn":"Focus 4 · FALLS — non-negotiables","titleEs":"Focus 4 · CAÍDAS — no negociables","pointsEn":["Working at 6 feet or more without fall protection (100% protection at 6 feet or more).","Not keeping 3 points of contact getting on/off equipment (includes fueling).","Leaving a hole 6 feet or more deep, that a person fits into, unprotected.","Altering, removing or disabling any part of a protection system: removing a guardrail or warning line and not replacing it; altering someone else's harness without permission.","Not tying off on an elevated platform (MEWP): boom lift, scissor lift, etc.","Ladder misuse: standing on the top cap, sitting or riding on top."],"pointsEs":["Trabajar a 6 pies o más sin protección contra caídas (100% protección a 6 pies o más).","No mantener 3 puntos de contacto al subir o bajar del equipo (incluye al echar combustible).","Dejar un hueco de 6 pies o más de profundidad, por donde cabe una persona, sin proteger.","Alterar, quitar o desactivar cualquier parte de un sistema de protección: quitar un barandal o línea de advertencia y no reponerla; alterar el arnés de otro sin permiso.","No amarrarse en una plataforma elevada (MEWP): boom lift, tijera, etc.","Uso indebido de escaleras: pararse en la tapa superior, sentarse o montarse encima."]},
  {"titleEn":"Focus 4 · CAUGHT-IN — non-negotiables","titleEs":"Focus 4 · ATRAPADO — no negociables","pointsEn":["Entering a trench or excavation 5 feet or more without cave-in protection (sloping, benching, shoring, box).","Entering a confined space without training, permit, equipment or a safety process.","An operator who doesn't barricade crush/pinch points between equipment and structures or other equipment.","An operator who doesn't barricade the swing radius of stationary equipment (cranes).","Getting into a caught hazard ignoring the barricade, without authorization from the contractor who set it.","An operator who exposes people to a load overhead in an excavation: loaded, empty or rigged bucket.","Reckless operation: horseplay, operating within 2 feet of a trench, damaging the counterweight, exceeding machine limits, defeating safety devices, operating in tight space without a spotter."],"pointsEs":["Entrar a una zanja o excavación de 5 pies o más sin protección contra derrumbe (talud, banqueo, apuntalamiento, caja).","Entrar a un espacio confinado sin entrenamiento, permiso, equipo o proceso de seguridad.","Operador que no barrica los puntos de aplastamiento o pellizco entre el equipo y estructuras u otro equipo.","Operador que no barrica el radio de giro de equipo estacionario (grúas).","Meterse en un peligro de atrapamiento ignorando la barricada, sin autorización del contratista que la puso.","Operador que expone gente a una carga sobre la cabeza en una excavación: cucharón cargado, vacío o con carga amarrada.","Operación imprudente: juegos, operar a menos de 2 pies de una zanja, dañar el contrapeso, exceder los límites de la máquina, anular dispositivos de seguridad, operar en espacio reducido sin señalero."]},
  {"titleEn":"Focus 4 · STRUCK-BY — non-negotiables","titleEs":"Focus 4 · GOLPEADO — no negociables","pointsEn":["Ignoring or crossing RED danger tape without authorization from the contractor who set it.","Exposing others to falling-object hazards: not barricading areas under masonry, roofing, welding, demolition, steel erection, formwork, penetrations.","Throwing debris from an elevated structure without a chute or a JBC-approved procedure.","Riding equipment not designed for passengers or in the bed of a pickup (\"hitching a ride\").","Seatbelt 100% when operating company equipment and vehicles.","Altering tools or equipment to defeat safety: removing a saw or grinder guard, disabling the safety on a nail gun or powder-actuated tool.","Rigging without training or intentional misuse of rigging equipment."],"pointsEs":["Ignorar o cruzar cinta ROJA de peligro sin autorización del contratista que la puso.","Exponer a otros a peligros de caída de objetos: no barricar áreas bajo mampostería, techado, soldadura, demolición, montaje de acero, formaletas, penetraciones.","Tirar escombro desde una estructura elevada sin chute o procedimiento aprobado por JBC.","Viajar en equipo no diseñado para pasajeros o en la caja de una pickup (\"pedir aventón\").","Cinturón de seguridad al 100% al operar equipo y vehículos de la compañía.","Alterar herramientas o equipo para anular la seguridad: quitar la guarda de una sierra o esmeril, desactivar el seguro de una clavadora neumática o herramienta de pólvora.","Aparejar (rigging) sin entrenamiento o mal uso intencional del equipo de aparejo."]},
  {"titleEn":"Focus 4 · ELECTRICAL / UTILITIES — non-negotiables","titleEs":"Focus 4 · ELÉCTRICO / SERVICIOS — no negociables","pointsEn":["Operating equipment or working within 10 feet of overhead power lines without a spotter (equipment, ladders, scaffolds, tools).","In transit, unloaded with the boom down: minimum 4 feet for under 50kV.","Exposing yourself or others to bare live conductors over 50 volts: open panels, junction boxes, missing knock-outs.","Working on live electricity without planning/approval, PPE and procedures. All live work is discussed with the owner or GC first.","Altering, defeating or removing without authorization guards, locks, tags or any device that protects from live electricity.","A competent person or operator who doesn't locate buried utilities before excavating, drilling, cutting or demolishing.","Not following the protocols to re-mark, hand-dig or pothole within the tolerance zone."],"pointsEs":["Operar equipo o trabajar a menos de 10 pies de líneas eléctricas aéreas sin señalero (equipo, escaleras, andamios, herramientas).","En tránsito sin carga y con el brazo abajo: mínimo 4 pies para menos de 50kV.","Exponerse o exponer a otros a conductores vivos descubiertos de más de 50 voltios: paneles abiertos, cajas de conexión, knock-outs faltantes.","Trabajar en electricidad viva sin planificación/aprobación, EPP y procedimientos. Todo trabajo vivo se habla con el dueño o GC antes.","Alterar, anular o quitar sin autorización guardas, candados, etiquetas u otro dispositivo que protege de electricidad viva.","Persona competente u operador que no localiza los servicios enterrados antes de excavar, perforar, cortar o demoler.","No seguir los protocolos de re-marcar, excavar a mano o hacer sondeos dentro de la zona de tolerancia."]},
  {"titleEn":"Safety Rules · Personal protective equipment (PPE)","titleEs":"Reglas de Seguridad · Equipo de protección personal (EPP)","pointsEn":["Minimum required on every JBC site: hard hat; safety glasses with side protection (Z87.1); hi-vis vest or shirt with reflective striping; safety-toe boots; gloves when working with your hands.","By site or task: FR clothing, respirator, hearing protection, face shield, etc.","What Jones Bros gives you: gloves (Cut III maxifoam, winter, leather, rubber); clear and dark glasses; a Class III vest and 5 hi-vis shirts a year; earplugs, hard hat and face shields.","Your supervisor has inventory — he calls safety when more is needed.","PPE is the LAST line of defense. If it's assigned to you, you wear it."],"pointsEs":["Mínimo requerido en todo sitio de JBC: casco; lentes de seguridad con protección lateral (Z87.1); chaleco o camisa de alta visibilidad con cintas reflectivas; botas con punta de seguridad; guantes cuando trabaje con las manos.","Según el sitio o la tarea: ropa FR, respirador, protección auditiva, careta, etc.","Lo que Jones Bros le da: guantes (Cut III maxifoam, de invierno, de cuero, de hule); lentes claros y oscuros; chaleco Clase III y 5 camisas de alta visibilidad al año; tapones de oído, casco y caretas.","Su supervisor tiene inventario — él llama a seguridad cuando necesita más.","El EPP es la ÚLTIMA línea de defensa. Si se le asigna, se usa."]},
  {"titleEn":"Safety Rules · PPE — Jones Bros specific rules","titleEs":"Reglas de Seguridad · EPP — reglas específicas de Jones Bros","pointsEn":["GREEN hi-vis hard hat for the first 90 days — it's your evaluation period.","Class III vest: much of our work is on the road and TDOT requires it. It's a sleeved vest — not just any vest.","If you're not on the road or near live traffic, you can wear a hi-vis shirt.","Don't wear another company's logo or vest.","When cutting with a saw or grinding: FACE SHIELD 100% of the time.","The face shield when cutting or grinding is a NON-NEGOTIABLE."],"pointsEs":["Casco VERDE de alta visibilidad los primeros 90 días — es su período de evaluación.","Chaleco Clase III: gran parte de nuestro trabajo es en carretera y TDOT lo exige. Es un chaleco con mangas — no cualquier chaleco.","Si no está en carretera ni cerca de tráfico vivo, puede usar camisa de alta visibilidad.","No use logo ni chaleco de otra compañía.","Al cortar con sierra o esmerilar: CARETA el 100% del tiempo.","La careta al cortar o esmerilar es un NO NEGOCIABLE."]},
  {"titleEn":"Safety Rules · Company vehicles and equipment","titleEs":"Reglas de Seguridad · Vehículos y equipo de la compañía","pointsEn":["Assigned vehicles: care for it as if it were yours — clean it and keep maintenance current.","Geotab monitors speed and location. Each truck must have a first-aid kit and an ABC extinguisher. Seatbelt 100%. Vehicle problems: contact Scott Ray.","Heavy equipment: all equipment is company property — use it as if it were yours, don't abuse it.","Each machine has Windex and Armor All to keep it clean. Several people may operate the same machine in a day: take your trash out of the cab before leaving it.","NO horseplay on or with the equipment. Only qualified personnel operate equipment."],"pointsEs":["Vehículos asignados: cuídelo como si fuera suyo — límpielo y mantenga el mantenimiento al día.","Geotab monitorea velocidad y ubicación. Cada camioneta debe tener botiquín y extintor ABC. Cinturón al 100%. Problemas con el vehículo: contacte a Scott Ray.","Equipo pesado: todo el equipo es propiedad de la compañía — úselo como si fuera suyo, no lo maltrate.","Cada máquina tiene Windex y Armorall para mantenerla limpia. Varias personas pueden operar la misma máquina en un día: saque su basura de la cabina antes de dejarla.","PROHIBIDO jugar en o con el equipo. Solo personal calificado opera equipo."]},
  {"titleEn":"Safety Rules · Heat and cold","titleEs":"Reglas de Seguridad · Calor y frío","pointsEn":["Heat: the #1 heat illness is heat stress. Signs: cold clammy skin, dizziness, fainting, fatigue, weak/fast pulse, cramps. If someone has these signs: get them to shade and give small sips of water.","Every supervisor has a cooler with water — and must bring ice every day. OSHA: 1 liter of water per hour, 4 ounces every 15 minutes. Take breaks as needed. Keep a change of dry clothes in your vehicle.","Cold: wear layers you can add and remove with the weather. Jones Bros provides winter gloves as part of PPE.","Watch for ice, snow and frozen ground — they change the terrain and the red zones. Less visibility in winter: more care around equipment."],"pointsEs":["Calor: la enfermedad #1 por calor es el estrés por calor. Señales: piel fría y húmeda, mareo, desmayo, fatiga, pulso débil/rápido, calambres. Si alguien tiene estas señales: llévelo a la sombra y dele agua en sorbos pequeños.","Todo supervisor tiene hielera con agua — y debe traer hielo todos los días. OSHA: 1 litro de agua por hora, 4 onzas cada 15 minutos. Tome descansos según necesite. Tenga un cambio de ropa seca en su vehículo.","Frío: use capas de ropa para quitarse y ponerse según el clima. Jones Bros da guantes de invierno como parte del EPP.","Cuidado con hielo, nieve y suelo congelado — cambian el terreno y las zonas rojas. Menos visibilidad en invierno: más cuidado alrededor del equipo."]},
  {"titleEn":"Safety Rules · Social media policy","titleEs":"Reglas de Seguridad · Política de redes sociales","pointsEn":["Think about what you post outside of work — it can come back to affect you.","No using social media during work.","Protect the company's confidential information.","Don't speak on the company's behalf unless authorized.","Don't post inappropriate or illegal content.","No retaliation against anyone who reports misuse of social media."],"pointsEs":["Piense en lo que publica fuera del trabajo — puede regresar a afectarlo.","Prohibido usar redes sociales durante el trabajo.","Proteja la información confidencial de la compañía.","No hable en nombre de la compañía a menos que esté autorizado.","No publique contenido inapropiado o ilegal.","Prohibidas las represalias contra quien reporte mal uso de redes sociales."]},
  {"titleEn":"Safety Rules · Hazard communication (HazCom)","titleEs":"Reglas de Seguridad · Comunicación de peligros (HazCom)","pointsEn":["Jones Bros keeps an inventory of every chemical on the job. Each chemical has a Safety Data Sheet (SDS).","All SDSs are in the MSDSonline app — every foreman has it. Paper copies: Safety Department or Purchasing (Jamie Jones or Christy Hart).","Every container must be labeled with the GHS system (pictograms). SDSs are kept for 30 years.","What an SDS contains (16 sections): product and manufacturer ID; hazards and composition; first aid; fire measures; what to do for a spill and how to clean it; handling, storage and recommended PPE; physical properties, stability, toxicity, disposal, transport."],"pointsEs":["Jones Bros mantiene un inventario de todos los químicos del trabajo. Cada químico tiene una Hoja de Datos de Seguridad (SDS).","Todas las SDS están en la app MSDSonline — todos los capataces la tienen. Copias en papel: Departamento de Seguridad o Compras (Jamie Jones o Christy Hart).","Todo envase debe estar etiquetado con el sistema GHS (pictogramas). Las SDS se guardan 30 años.","Qué trae una SDS (16 secciones): identificación del producto y fabricante; peligros y composición; primeros auxilios; medidas contra incendio; qué hacer si se derrama y cómo limpiarlo; manejo, almacenamiento y EPP recomendado; propiedades físicas, estabilidad, toxicidad, disposición, transporte."]},
  {"titleEn":"Safety Rules · Hierarchy of controls","titleEs":"Reglas de Seguridad · Jerarquía de controles","pointsEn":["From most to least effective:","1) ELIMINATE — remove the hazard completely. This is the main goal.","2) SUBSTITUTE — swap the hazard for something less dangerous (another chemical, quieter equipment).","3) ENGINEERING CONTROLS — isolate people from the hazard (ventilation, guardrails, guards).","4) ADMINISTRATIVE CONTROLS — change how you work (signs, training, rotation).","5) PPE — the last resort and least effective. The hazard is still there."],"pointsEs":["De más a menos efectivo:","1) ELIMINAR — quitar el peligro por completo. Esta es la meta principal.","2) SUSTITUIR — cambiar el peligro por algo menos peligroso (otro químico, equipo menos ruidoso).","3) CONTROLES DE INGENIERÍA — aislar a la gente del peligro (ventilación, barandales, guardas).","4) CONTROLES ADMINISTRATIVOS — cambiar la forma de trabajar (señales, entrenamiento, rotación).","5) EPP — el último recurso y el menos efectivo. El peligro sigue ahí."]},
  {"titleEn":"Hazards · OSHA's Fatal Four (2024)","titleEs":"Peligros · Los 4 peligros mortales de OSHA (2024)","pointsEn":["1,000+ construction workers died on the job in 2024.","Falls — the #1 cause, about 1 in 3 (≈ 370-390 deaths).","Struck-by object or equipment — about 11%.","Electrocution — about 8% (and ~5% caught-between).","The four together cause about 60% of construction deaths. The industry rate has been stuck for years at 9-10 deaths per 100,000 workers — nearly double the average of all industries. Almost all are preventable.","Source: BLS Census of Fatal Occupational Injuries (CFOI) 2024; OSHA."],"pointsEs":["1,000+ trabajadores de construcción murieron en el trabajo en 2024.","Caídas — la causa #1, cerca de 1 de cada 3 (≈ 370-390 muertes).","Golpeado por objeto o equipo — cerca del 11%.","Electrocución — cerca del 8% (y ~5% atrapado entre).","Los 4 juntos causan cerca del 60% de las muertes en construcción. La tasa lleva años estancada entre 9 y 10 muertes por cada 100,000 trabajadores — casi el doble del promedio de todas las industrias. Casi todas se pueden prevenir.","Fuente: BLS, Censo de Lesiones Ocupacionales Fatales (CFOI) 2024; OSHA."]},
  {"titleEn":"Hazards · Falls — how to prevent them","titleEs":"Peligros · Caídas — cómo evitarlas","pointsEn":["The hazard: the #1 cause of death in construction. They happen from height and also at the same level. Bridges, excavations, open edges, holes, ladders, equipment.","What you do: get on/off equipment with 3 points of contact.","Use your harness and tie off when required.","Install and maintain perimeter protection.","Cover and secure floor holes — mark them \"HOLE\".","Use ladders and scaffolds correctly."],"pointsEs":["El peligro: la causa #1 de muerte en construcción. Pasan desde altura y también al mismo nivel. Puentes, excavaciones, bordes abiertos, huecos, escaleras, equipo.","Lo que usted hace: suba y baje del equipo con 3 puntos de contacto.","Use su arnés y amárrese cuando se requiera.","Instale y mantenga protección perimetral.","Cubra y asegure los huecos en el piso — márquelos \"HOLE\".","Use escaleras y andamios correctamente."]},
  {"titleEn":"Hazards · Struck-by — how to prevent it","titleEs":"Peligros · Golpeado — cómo evitarlo","pointsEn":["The hazard: occurs when you get between a moving object and a fixed one. Moving equipment, suspended loads, swing radius, falling objects, traffic.","What you do: always hi-vis clothing near equipment and vehicles.","Identify the RED ZONES.","Never under a suspended load. Respect the swing radius.","Eye contact with the operator before approaching.","Never approach moving equipment until it stops completely."],"pointsEs":["El peligro: ocurre cuando se pone entre un objeto en movimiento y uno fijo. Equipo en movimiento, cargas suspendidas, radio de giro, objetos que caen, tráfico.","Lo que usted hace: siempre ropa de alta visibilidad cerca de equipo y vehículos.","Identifique las ZONAS ROJAS.","Nunca bajo una carga suspendida. Respete el radio de giro.","Contacto visual con el operador antes de acercarse.","Nunca se acerque a equipo en movimiento hasta que se detenga por completo."]},
  {"titleEn":"Hazards · Electrocution — how to prevent it","titleEs":"Peligros · Electrocución — cómo evitarla","pointsEn":["The hazard: death or serious injury from electric current passing through the body. What matters: voltage, your body's resistance, the current's path, and how long it lasts.","LOW VOLTAGE DOES NOT MEAN LOW DANGER.","What you do: locate and identify buried utilities before starting.","Look for overhead lines before operating any equipment — minimum 10 feet. Assume EVERY overhead line is energized, even if it looks insulated or is down.","Use GFCI with power tools. Never operate electric equipment standing in water.","Inspect cords and tools; don't repair them if you're not qualified."],"pointsEs":["El peligro: muerte o lesión grave por corriente eléctrica pasando por el cuerpo. Lo que cuenta: voltaje, resistencia de su cuerpo, la ruta de la corriente y cuánto tiempo pasa.","BAJO VOLTAJE NO SIGNIFICA BAJO PELIGRO.","Lo que usted hace: localice e identifique los servicios enterrados antes de empezar.","Busque líneas aéreas antes de operar cualquier equipo — mínimo 10 pies. Asuma que TODA línea aérea está energizada, aunque parezca aislada o esté caída.","Use GFCI con herramientas eléctricas. Nunca opere equipo eléctrico parado en agua.","Inspeccione cables y herramientas; no los repare si no está calificado."]},
  {"titleEn":"Hazards · Caught-between — how to prevent it","titleEs":"Peligros · Atrapado entre — cómo evitarlo","pointsEn":["The hazard: getting trapped, crushed, squeezed or pinched between two or more objects. Example #1: trench cave-in. Also: swing radius, pinch points, rollovers.","What you do: NEVER enter a trench or excavation without protection.","Confirm there is sloping, benching, shoring or a box before entering.","Never stand between a moving object and a fixed one.","Stay out of the swing radius.","Never inside the trench while a load is being lowered."],"pointsEs":["El peligro: quedar atrapado, aplastado, apretado o pellizcado entre dos o más objetos. Ejemplo #1: derrumbe de zanja. También: radio de giro, puntos de pellizco, volcaduras.","Lo que usted hace: NUNCA entre a una zanja o excavación sin protección.","Confirme que hay talud, banqueo, apuntalamiento o caja antes de entrar.","Nunca se pare entre un objeto en movimiento y uno fijo.","Manténgase fuera del radio de giro.","Nunca dentro de la zanja mientras bajan una carga."]},
  {"titleEn":"Hazards · Risky behaviors","titleEs":"Peligros · Comportamientos de riesgo","pointsEn":["Pre-inspection: check the area, surroundings, equipment and tools before starting.","Right tool: don't use a screwdriver as a pry bar, a wrench as a hammer, or a rock instead of a post maul.","Line of fire: never in the path of a moving object — travel lanes, swing radius, loads, stored energy.","Eyes on the path and the task: watch where you walk and where the machine goes — up, down, obstacles.","Footing: firm base when using tools, climbing equipment or ladders; keep steps clean.","PPE: if it was assigned to you, you wear it.","Ask yourself: what's my perception of the risk? how much risk am I willing to accept? If you don't know or don't understand: ASK."],"pointsEs":["Inspección previa: revise el área, los alrededores, el equipo y las herramientas antes de empezar.","Herramienta correcta: no use un destornillador de palanca, una llave de martillo, ni una piedra en vez del mazo para postes.","Línea de fuego: nunca en el camino de un objeto en movimiento — carriles de tránsito, radio de giro, cargas, energía almacenada.","Ojos en la ruta y en la tarea: vea por dónde camina y por dónde va la máquina — arriba, abajo, obstáculos.","Pisada: base firme al usar herramientas, subir a equipo o escaleras; escalones limpios.","EPP: si se le asignó, se usa.","Pregúntese: ¿cuál es mi percepción del riesgo? ¿cuánto riesgo estoy dispuesto a aceptar? Si no sabe o no entiende: PREGUNTE."]},
  {"titleEn":"Hazards · Heavy equipment — operator rules","titleEs":"Peligros · Equipo pesado — reglas para el operador","pointsEn":["Before starting (documented inspection): exterior — lights, steps, tires/tracks, exhaust, attachments, hoses, windows, mirrors, ROPS. Cab — controls, brakes, backup alarm, gauges, horn, seatbelt. Fluids — fuel, oil, coolant, transmission. Extinguisher and spill kit.","Leaks or damaged parts: DO NOT use it, report it and take it out of service.","While operating: only trained and authorized operators. Seatbelt always. Phone prohibited.","Know your blind spots and use a spotter. Know the capacity — check the load chart and manual.","Getting off: bucket/blade down, brake and safety lever set, nothing suspended. Load and unload on level ground."],"pointsEs":["Antes de arrancar (inspección documentada): exterior — luces, escalones, llantas/orugas, escape, aditamentos, mangueras, ventanas, espejos, ROPS. Cabina — controles, frenos, alarma de reversa, medidores, claxon, cinturón. Fluidos — combustible, aceite, anticongelante, transmisión. Extintor y kit de derrames.","Fugas o partes dañadas: NO la use, repórtelo y sáquela de servicio.","Mientras opera: solo operadores entrenados y autorizados. Cinturón siempre. Celular prohibido.","Conozca sus puntos ciegos y use señalero. Conozca la capacidad — revise la tabla de carga y el manual.","Al bajarse: cucharón/hoja abajo, freno y palanca de seguridad puestos, nada suspendido. Cargue y descargue en terreno nivelado."]},
  {"titleEn":"Hazards · Red zones and spotters","titleEs":"Peligros · Zonas rojas y señaleros (spotters)","pointsEn":["Red zones: dangerous areas around equipment — swing radius, moving parts, pinch points.","ALWAYS assume the operator doesn't see you. Never enter a red zone without eye contact with the operator or spotter.","Never approach moving equipment until it stops and shuts off. Weather and terrain extend the red zone: ice, loose material, mud, slopes.","A spotter is REQUIRED for: overhead power lines; exposing buried utilities; congested areas; traveling in reverse or with obstructed view; near structures and buildings.","The spotter has NO other task. Communication by radio, hand signals or horn — never assume."],"pointsEs":["Zonas rojas: áreas peligrosas alrededor del equipo — radio de giro, partes móviles, puntos de pellizco.","Asuma SIEMPRE que el operador no lo ve. Nunca entre a una zona roja sin contacto visual con el operador o el señalero.","Nunca se acerque a equipo en movimiento hasta que pare y se apague. El clima y el terreno extienden la zona roja: hielo, material suelto, lodo, pendientes.","Se REQUIERE señalero para: líneas eléctricas aéreas; exponer servicios enterrados; áreas congestionadas; viajar en reversa o con vista obstruida; cerca de estructuras y edificios.","El señalero NO tiene otra tarea. Comunicación por radio, señales de mano o bocina — nunca asuma."]},
  {"titleEn":"Hazards · Trenches and excavations — the hazard","titleEs":"Peligros · Zanjas y excavaciones — el peligro","pointsEn":["Excavation: any man-made cut, cavity, trench or depression made by removing soil.","Trench: a narrow excavation, deeper than it is wide, no more than 15 feet wide.","Cave-in is the biggest and most deadly risk. Other hazards: falls, falling loads, hazardous atmospheres, mobile equipment.","The weight of soil: a 1-foot cube of soil weighs 100 pounds. A cubic yard weighs 2,700 pounds — the weight of a car.","A cave-in gives you no time to get out. Never inside the trench while a load is being lowered."],"pointsEs":["Excavación: cualquier corte, cavidad, zanja o depresión hecha por el hombre al remover tierra.","Zanja: excavación angosta, más profunda que ancha, de no más de 15 pies de ancho.","El derrumbe es el mayor riesgo y el más mortal. Otros peligros: caídas, cargas que caen, atmósferas peligrosas, equipo móvil.","El peso de la tierra: un cubo de tierra de 1 pie por lado pesa 100 libras. Una yarda cúbica pesa 2,700 libras — el peso de un carro.","Un derrumbe no le da tiempo de salir. Nunca dentro de la zanja mientras bajan una carga."]},
  {"titleEn":"Hazards · Competent person and soil types","titleEs":"Peligros · Persona competente y tipos de suelo","pointsEn":["The competent person MUST be present when opening any trench or excavation.","Classifies the soil with visual and manual tests. Has training to recognize hazards and AUTHORITY to correct them immediately.","Completes the daily excavation checklist BEFORE anyone enters. If conditions change during the day: a new checklist.","Soil types: Type A — most stable: clay, silty clay, hardpan. Type B — medium stability: silt, sandy loam, medium clay. Type C — least stable: gravel, sand, soft clay, submerged soil.","Previously disturbed soil = treated as Type C. With water present = treated as Type C."],"pointsEs":["La persona competente DEBE estar presente al abrir cualquier zanja o excavación.","Clasifica el suelo con pruebas visuales y manuales. Tiene entrenamiento para reconocer peligros y AUTORIDAD para corregirlos de inmediato.","Completa la lista diaria de excavación ANTES de que alguien entre. Si cambian las condiciones durante el día: lista nueva.","Tipos de suelo: Tipo A — más estable: arcilla, arcilla limosa, hardpan. Tipo B — estabilidad media: limo, franco arenoso, arcilla media. Tipo C — menos estable: grava, arena, arcilla blanda, suelo sumergido.","Suelo previamente alterado = se trata como Tipo C. Con agua presente = se trata como Tipo C."]},
  {"titleEn":"Hazards · Trenches: 5 · 4 · 3 · 2 · 1 · 0","titleEs":"Peligros · Zanjas: 5 · 4 · 3 · 2 · 1 · 0","pointsEn":["5 — At 5 feet or more deep a protective system is required: sloping, benching, shoring or a box.","4 — At 4 feet or more a means of exit (ladder) is required no more than 25 feet from any worker.","3 — The ladder must extend 3 feet above the excavation and be secured (to a T-post or the box).","2 — Excavated material and equipment at least 2 feet from the trench edge.","1 — 1 competent person always present.","0 — ZERO excuses to enter an unsafe trench."],"pointsEs":["5 — A 5 pies o más de profundidad se requiere un sistema de protección: talud, banqueo, apuntalamiento o caja.","4 — A 4 pies o más se requiere un medio de salida (escalera) a no más de 25 pies de cualquier trabajador.","3 — La escalera debe sobresalir 3 pies de la excavación y estar asegurada (a un poste T o a la caja).","2 — Material excavado y equipo a mínimo 2 pies del borde de la zanja.","1 — 1 persona competente siempre presente.","0 — CERO excusas para entrar a una zanja insegura."]},
  {"titleEn":"Hazards · Protective systems","titleEs":"Peligros · Sistemas de protección","pointsEn":["Trench box: no one inside the box while it's installed or removed. Compatible, secured and well-connected components.","The bottom of the box can be up to 2 feet (24\") above the trench bottom. It must be backfilled on both sides and stick up 18\" above the walls. Tabulated data must be on site with the box. Enter and exit INSIDE the box — never walk outside the system.","Other rules: sloping and benching per soil type. 20 feet or more deep: system designed by a registered engineer. Open excavations at night: RED tape, orange fence or barriers.","Signs the soil is going to fail: cracks, material sloughing off, a wall bulging at the bottom, small stones falling, the edge sinking. If you see any: EVERYONE OUT and report it."],"pointsEs":["Caja de zanja (trench box): nadie dentro de la caja mientras se instala o se saca. Componentes compatibles, asegurados y conectados bien.","El fondo de la caja puede estar hasta 2 pies (24\") arriba del fondo de la zanja. Debe rellenarse a ambos lados y sobresalir 18\" arriba de las paredes. Los datos tabulados deben estar en el sitio con la caja. Entre y salga DENTRO de la caja — nunca camine fuera del sistema.","Otras reglas: talud y banqueo según el tipo de suelo. 20 pies o más de profundidad: sistema diseñado por ingeniero registrado. Excavaciones abiertas de noche: cinta ROJA, cerca naranja o barreras.","Señales de que el suelo va a fallar: grietas, material que se desprende, pared que se abomba abajo, piedritas que caen, el borde se hunde. Si ve alguna: TODOS AFUERA y avise."]},
  {"titleEn":"Hazards · Fall protection","titleEs":"Peligros · Protección contra caídas","pointsEn":["The rules: construction — protection at 6 feet or more. General industry — 4 feet. Confirm which applies at each site.","Bridges, excavations, edges, elevated platforms — it all counts.","Guardrail on site: top rail at 42\", mid rail at 21\", and toe board. Floor holes: guardrail or a secured cover marked \"HOLE\". Guardrail regardless of height if you can fall onto dangerous equipment.","Personal fall arrest system (PFAS): full-body harness — fitted to YOU, not one size fits all. Shock-absorbing or retractable lifeline, double-locking snap hooks. Anchor point that holds 5,000 pounds.","Inspect the harness every day before use. Any tear, cut or wear on the straps: it's DISCARDED. Always tie off on a boom lift, scissor lift and any MEWP."],"pointsEs":["Las reglas: construcción — protección a 6 pies o más. Industria general — 4 pies. Confirme cuál aplica en cada sitio.","Puentes, excavaciones, bordes, plataformas elevadas — todo cuenta.","Barandal en sitio: barra superior a 42\", barra media a 21\", y rodapié. Huecos en el piso: barandal o tapa asegurada marcada \"HOLE\". Barandal sin importar la altura si puede caer sobre equipo peligroso.","Sistema personal de detención (PFAS): arnés de cuerpo completo — ajustado a USTED, no es talla única. Cuerda de vida con amortiguador o retráctil, ganchos de doble seguro. Punto de anclaje que aguante 5,000 libras.","Inspeccione el arnés cada día antes de usarlo. Cualquier rasgón, corte o desgaste en las correas: se DESCARTA. Amárrese siempre en boom lift, tijera y cualquier MEWP."]},
  {"titleEn":"Hazards · Ladders","titleEs":"Peligros · Escaleras","pointsEn":["Only approved ladders — fiberglass. Inspect before each use.","3 points of contact always. One person on the ladder. Firm, level base — check the ground beneath.","Extension ladder: secure the top, 4-to-1 angle. Never use the top 2 rungs. Never stand on the cap or straddle it.","Stepladder (A): braces fully open, never used as an extension ladder.","If you work from the ladder at height: use fall arrest."],"pointsEs":["Solo escaleras aprobadas — de fibra de vidrio. Inspeccione antes de cada uso.","3 puntos de contacto siempre. Una sola persona en la escalera. Base firme y nivelada — revise el suelo debajo.","Escalera de extensión: asegure la parte de arriba, ángulo 4 a 1. Nunca use los 2 peldaños de arriba. Nunca se pare en la tapa ni se monte a horcajadas.","Escalera de tijera (A): braces completamente abiertos, nunca como escalera de extensión.","Si trabaja desde la escalera en altura: use detención de caídas."]},
  {"titleEn":"Hazards · Cranes, rigging and signals","titleEs":"Peligros · Grúas, aparejo (rigging) y señales","pointsEn":["Jones Bros rules: only certified operators operate cranes. Whoever rigs or gives signals MUST take the rigging/signals course (by a third party) before doing it.","Chains, slings and hooks: approved, with marked capacity and a tag — no tag, no use. Rigging without training is a Focus 4 NON-NEGOTIABLE. Never use wire rope clips for slings or lifts.","The basics everyone must know: inspect the rigging before each lift; damaged gear is taken out of service. Protect slings from sharp edges; no knots or twists; don't pull them out from under the load.","A tighter sling angle = more tension on the sling. Tag lines: long, no loops, non-conductive. NEVER wrapped around the body. No one under the load. No one between the load and the equipment or a structure."],"pointsEs":["Reglas de Jones Bros: solo operadores certificados operan grúas. Quien apareja o da señales DEBE tomar el curso de rigging/señales (por tercero) antes de hacerlo.","Cadenas, eslingas y ganchos: aprobados, con capacidad marcada y con etiqueta — sin etiqueta no se usa. Aparejar sin entrenamiento es un NO NEGOCIABLE del Focus 4. Nunca use grapas de cable (wire rope clips) para eslingas ni izajes.","Lo básico que todos deben saber: inspeccione el aparejo antes de cada izaje; lo dañado se saca de servicio. Proteja las eslingas de bordes filosos; sin nudos ni torceduras; no las jale por debajo de la carga.","Ángulo de eslinga más cerrado = más tensión en la eslinga. Líneas guía (tag lines): largas, sin lazos, no conductoras. NUNCA enrollada en el cuerpo. Nadie bajo la carga. Nadie entre la carga y el equipo o una estructura."]},
  {"titleEn":"Hazards · Confined space — awareness","titleEs":"Peligros · Espacio confinado — conciencia","pointsEn":["What it is: limited openings to enter/exit, enough space to work, not designed for continuous occupancy.","Permit-required space: may have a hazardous atmosphere, engulfing material, converging walls or other serious hazards. DO NOT ENTER without training and a permit — it's a non-negotiable. Additional training is required to enter.","Gas monitor (Altair 4X): normal oxygen 20.9%. OSHA minimum 19.5%. Enriched: over 23.5%.","Detects flammable gases (LEL) and toxics: H2S (rotten-egg smell, then you can't smell it) and carbon monoxide (odorless — \"the silent killer,\" from engines and compressors).","Inspect before each use; calibration every 6 months. If the alarm sounds: STOP, exit calmly, remove ignition sources, notify the chain of command."],"pointsEs":["Qué es: aberturas limitadas para entrar/salir, suficiente espacio para trabajar, no diseñado para ocupación continua.","Espacio con permiso requerido: puede tener atmósfera peligrosa, material que sepulta, paredes que convergen u otros peligros serios. NO ENTRE sin entrenamiento y sin permiso — es un no negociable. Se requiere entrenamiento adicional para entrar.","Monitor de gases (Altair 4X): oxígeno normal 20.9%. Mínimo OSHA 19.5%. Enriquecido: más de 23.5%.","Detecta gases inflamables (LEL) y tóxicos: H2S (olor a huevo podrido, luego ya no lo huele) y monóxido de carbono (sin olor — \"el asesino silencioso\", de motores y compresores).","Inspeccione antes de cada uso; calibración cada 6 meses. Si suena la alarma: PARE, salga con calma, elimine fuentes de ignición, avise a la cadena de mando."]},
  {"titleEn":"Hazards · Fire and hot work","titleEs":"Peligros · Fuego y trabajo en caliente","pointsEn":["Extinguishers: all company equipment has a 20-pound ABC extinguisher. Every company pickup has an ABC extinguisher.","P.A.S.S. method: Pull the pin, Aim at the base, Squeeze, Sweep.","For a fire you need: fuel, oxygen in the right proportion, and an ignition source.","Hot work (grinding, cutting, welding): do it in a safe place, with no flammable or combustible material nearby. Use screens to contain sparks and slag. PPE: face shield, welding gloves, FR clothing. Inspect the equipment before use.","With a hot-work permit: a FIRE WATCH with an extinguisher on hand, no other task, who stays 30 minutes after finishing."],"pointsEs":["Extintores: todo equipo de la compañía tiene extintor ABC de 20 libras. Toda pickup de la compañía tiene extintor ABC.","Método P.A.S.S.: jale el Pin, Apunte a la base, apriete (Squeeze), barra (Sweep).","Para que haya fuego se necesita: combustible, oxígeno en la proporción correcta y una fuente de ignición.","Trabajo en caliente (esmerilar, cortar, soldar): hágalo en un lugar seguro, sin material inflamable o combustible cerca. Use pantallas para contener chispas y escoria. EPP: careta, guantes de soldar, ropa FR. Inspeccione el equipo antes de usarlo.","Con permiso de trabajo en caliente: un VIGÍA DE FUEGO con extintor a la mano, sin otra tarea, que se queda 30 minutos después de terminar."]},
  {"titleEn":"Hazards · Lockout/Tagout (LOTO)","titleEs":"Peligros · Bloqueo y etiquetado (LOTO)","pointsEn":["1) Preparation — identify all energy sources.","2) Shutdown — turn off the machine.","3) Isolation — disconnect or cut the energy.","4) Lockout and tagout — YOUR lock and YOUR tag where it can't be started.","5) Stored energy — release hydraulics, pressure, springs, gravity.","6) Verification — try to start it to confirm it won't turn on.","Only the person who put the lock on can remove it. No one else — not even with your permission."],"pointsEs":["1) Preparación — identifique todas las fuentes de energía.","2) Apagado — apague la máquina.","3) Aislamiento — desconecte o corte la energía.","4) Bloqueo y etiquetado — SU candado y SU etiqueta donde no se pueda arrancar.","5) Energía almacenada — libere hidráulica, presión, resortes, gravedad.","6) Verificación — intente arrancar para confirmar que no enciende.","Solo la persona que puso el candado lo puede quitar. Nadie más — ni con su permiso."]},
  {"titleEn":"Hazards · Electricity and tools","titleEs":"Peligros · Electricidad y herramientas","pointsEn":["Electricity hazards: shock and burns, faults that cause fire, ignition in explosive atmospheres.","Never operate electric equipment standing in water. Never repair cords or equipment if you're not qualified and authorized. Inspect cords and equipment — no defects. Use GFCI.","Hand and power tools: the right tool for the job, as the manufacturer directs. Inspect before use; keep maintenance current.","All guards in place — removing a guard is a non-negotiable. Never carry a tool by the cord or pull the cord to unplug it.","Keep cords away from heat, oil and sharp edges. Unplug when not in use; secure the workpiece; keep people at a safe distance."],"pointsEs":["Peligros de la electricidad: choque y quemaduras, fallas que causan incendio, ignición en atmósferas explosivas.","Nunca opere equipo eléctrico parado en agua. Nunca repare cables o equipo si no está calificado y autorizado. Inspeccione cables y equipo — sin defectos. Use GFCI.","Herramientas manuales y eléctricas: la herramienta correcta para el trabajo, como el fabricante indica. Inspeccione antes de usar; mantenimiento al día.","Todas las guardas puestas — quitar una guarda es un no negociable. Nunca cargue una herramienta por el cable ni jale el cable para desconectar.","Cables lejos de calor, aceite y bordes filosos. Desconecte cuando no se usa; asegure la pieza; gente a distancia segura."]},
  {"titleEn":"Hazards · Concrete and silica","titleEs":"Peligros · Concreto y sílice","pointsEn":["Concrete burns: concrete is a big part of our work and has hazards. If it touches the skin and isn't cleaned in time, it leaves a painful burn like a bad sunburn.","If concrete gets on you: clean it immediately and rinse with fresh water. When pouring: Tyvek suit, thick rubber gloves and rubber boots.","Silica dust: cutting, sawing or drilling existing concrete produces dust with silica. Silica causes silicosis in the lungs — it's permanent.","Always use water when cutting, sawing or drilling to knock down the dust. Also: a dust mask or half-face respirator."],"pointsEs":["Quemaduras por concreto: el concreto es gran parte de nuestro trabajo y tiene peligros. Si toca la piel y no se limpia a tiempo, deja una quemadura dolorosa como una insolación fuerte.","Si le cae concreto: límpielo de inmediato y enjuague con agua fresca. Al vaciar: traje Tyvek, guantes gruesos de hule y botas de hule.","Polvo de sílice: cortar, aserrar o perforar concreto existente produce polvo con sílice. La sílice causa silicosis en los pulmones — es permanente.","Siempre use agua al cortar, aserrar o perforar para bajar el polvo. Además: mascarilla contra polvo o respirador de media cara."]},
  {"titleEn":"Hazards · Roadwork and flagging","titleEs":"Peligros · Trabajo en carretera y abanderamiento (flagging)","pointsEn":["Roadwork is central to JBC and among the most dangerous things we do.","Class III sleeved vest — the one TDOT allows for working on the road. Flagging course is MANDATORY to direct traffic in lane closures or crossings. Safety schedules it; renewed every 2 years.","STOP/SLOW paddles required to stop traffic. Two-way radios when there are flaggers at both ends. No earbuds or phone while directing traffic.","Warning signs required on EVERY flagged lane closure: ROAD WORK AHEAD, ONE LANE ROAD AHEAD, and the flagger symbol.","Optional: BE PREPARED TO STOP (between the symbol and ONE LANE ROAD) and END ROAD WORK. The flagger must be visible to traffic in order to stop it."],"pointsEs":["El trabajo en carretera es central para JBC y de lo más peligroso que hacemos.","Chaleco Clase III con mangas — el que TDOT permite para trabajar en la carretera. Curso de abanderamiento OBLIGATORIO para dirigir tráfico en cierres de carril o cruces. Seguridad lo programa; se renueva cada 2 años.","Paletas STOP/SLOW obligatorias para detener tráfico. Radios de 2 vías cuando hay abanderadores en los dos extremos. Prohibidos audífonos y celular mientras dirige tráfico.","Señales de advertencia requeridas en TODO cierre de carril con abanderamiento: ROAD WORK AHEAD, ONE LANE ROAD AHEAD, y el símbolo de abanderador.","Opcionales: BE PREPARED TO STOP (entre el símbolo y ONE LANE ROAD) y END ROAD WORK. El abanderador debe ser visible al tráfico para poder detenerlo."]},
  {"titleEn":"What you take away today","titleEs":"Lo que se lleva hoy","pointsEn":["You have the authority to STOP WORK — use it.","Report EVERYTHING the same day: Roman Kelly 270-227-3886 → Colin Rice 615-585-6930 → Andrew Wall. Written report within 24 hours.","Focus 4 non-negotiables send you home without pay — carry your card.","Green hard hat 90 days · Class III vest on the road · Face shield when cutting or grinding · Seatbelt always.","Trench: 5 ft protection · 4 ft exit · 3 ft ladder · 2 ft material · 1 competent person · 0 excuses.","10 feet from power lines. Never under a load. Never in a red zone without eye contact.","Don't know or don't understand? ASK. HR: HR@jonesbroscont.com · 615-773-3160.","Division One Safety, LLC · Daniel Forero, CHST · 615-480-3269."],"pointsEs":["Usted tiene autoridad para PARAR EL TRABAJO — úsela.","Reporte TODO el mismo día: Roman Kelly 270-227-3886 → Colin Rice 615-585-6930 → Andrew Wall. Reporte escrito en 24 horas.","Los no negociables del Focus 4 lo mandan a casa sin pago — lleve su tarjeta.","Casco verde 90 días · Chaleco Clase III en carretera · Careta al cortar o esmerilar · Cinturón siempre.","Zanja: 5 pies protección · 4 pies salida · 3 pies escalera · 2 pies material · 1 persona competente · 0 excusas.","10 pies de líneas eléctricas. Nunca bajo una carga. Nunca en una zona roja sin contacto visual.","¿No sabe o no entiende? PREGUNTE. HR: HR@jonesbroscont.com · 615-773-3160.","Division One Safety, LLC · Daniel Forero, CHST · 615-480-3269."]}
];

